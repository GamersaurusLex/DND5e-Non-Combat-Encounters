<div class="nce-roll-confirmation standard-form">
  <header><h2>{{request.actorName}} → {{request.targetName}}</h2><p><strong>{{request.checkLabel}} {{modifier}}</strong> against DC {{dc}}</p></header>
  {{#if openEnded}}<fieldset class="nce-open-ended-check"><legend>GM Adjudication</legend><div class="nce-config-grid"><label>Check<select name="checkKey">{{selectOptions checkChoices selected="ability:str"}}</select></label><label>DC<input type="number" min="0" name="dc" value="15"></label></div><p class="hint">Choose the check and DC after hearing the player's approach. Only the selected character's proficient tools are listed.</p></fieldset>{{/if}}
  <div class="form-group"><label>Situational Modifier</label><div class="form-fields"><input type="number" name="bonus" value="0"></div></div>
  <div class="form-group"><label>DC Adjustment</label><div class="form-fields"><input type="number" name="dcAdjust" value="0"></div></div>
  <div class="form-group"><label>Reason</label><div class="form-fields"><input type="text" name="bonusNote" placeholder="Optional note"></div></div>
  {{#if exhaustion.label}}<p class="nce-exhaustion-note"><i class="fa-solid fa-person-running"></i> <strong>{{exhaustion.label}}</strong>{{#if exhaustion.disadvantage}} — this check is made with disadvantage.{{/if}}</p>{{/if}}
  {{#if modifiers.length}}<fieldset class="nce-adjudication-modifiers"><legend>Configured Modifiers</legend>{{#each modifiers}}<label><input type="checkbox" name="modifierIds" value="{{id}}" {{checked checked}}><span><strong>{{label}}</strong> {{signedValue}}{{#if description}} — {{description}}{{/if}}{{#if uses}} ({{remaining}} use(s) left){{/if}}</span></label>{{/each}}</fieldset>{{/if}}
  <div class="form-group"><label>Roll Visibility</label><div class="form-fields"><select name="rollMode"><option value="publicroll">Public Roll</option><option value="gmroll">Private GM Roll</option><option value="blindroll">Blind GM Roll</option><option value="selfroll">Self Roll</option></select></div></div>
  <p class="hint">{{criticalHint}}</p>
  <footer class="nce-roll-buttons"><button type="button" data-action="disadvantage"><i class="fa-solid fa-angles-down"></i> Confirm with Disadvantage</button><button type="button" class="default" data-action="normal"><i class="fa-solid fa-dice-d20"></i> Confirm Roll</button><button type="button" data-action="advantage"><i class="fa-solid fa-angles-up"></i> Confirm with Advantage</button></footer>
</div>

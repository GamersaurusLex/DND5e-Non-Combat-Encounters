<div class="nce-editor">
  <section class="content">
    <fieldset><legend>Encounter</legend>
      <div class="form-group"><label>Name</label><div class="form-fields"><input name="name" value="{{encounter.name}}"></div></div>
      <div class="form-group"><label>Type</label><div class="form-fields"><select name="type">{{selectOptions typeLabels selected=encounter.type}}</select></div></div>
      <div class="form-group"><label>Image</label><div class="form-fields"><file-picker type="image" name="image" value="{{encounter.image}}"></file-picker></div></div>
      <div class="form-group"><label>Background Image</label><div class="form-fields"><file-picker type="image" name="backgroundImage" value="{{encounter.backgroundImage}}"></file-picker><span>Optional; uses the encounter image when blank.</span></div></div>
      <label>Description and Stakes<textarea name="description">{{encounter.description}}</textarea></label>
      <div class="form-group"><label>Current Round</label><div class="form-fields"><input type="number" min="1" name="currentRound" value="{{encounter.currentRound}}"><label>Round Limit</label><input type="number" min="0" name="roundLimit" value="{{encounter.roundLimit}}"></div></div>
      <div class="form-group"><label>Player DC Visibility</label><div class="form-fields"><select name="dcVisibility">{{selectOptions dcVisibilities selected=encounter.dcVisibility}}</select></div></div>
      <div class="form-group"><label>Critical Results</label><div class="form-fields"><select name="criticalMode">{{selectOptions criticalModes selected=encounter.criticalMode}}</select></div></div>
      {{#if isConsequenceChase}}<p class="hint nce-forced-setting"><i class="fa-solid fa-lock"></i> Consequence Chases automatically advance after every eligible participant has acted.</p>{{else}}<label class="checkbox"><input type="checkbox" name="autoAdvance" {{checked encounter.autoAdvance}}> Automatically advance the round once every eligible participant has acted</label>{{/if}}
      <details class="nce-dc-reference"><summary><i class="fa-solid fa-table-cells-large"></i> 5e DC Reference</summary><div>{{#each dcReference}}<span><strong>{{dc}}</strong> {{label}}</span>{{/each}}</div></details>
      {{#if isResearch}}<div class="form-group"><label>Research Interval</label><div class="form-fields"><input type="number" min="1" name="research.intervalHours" value="{{encounter.research.intervalHours}}"><span>hours per check</span></div></div><div class="form-group"><label>Research Points</label><div class="form-fields"><select name="research.pointMode">{{selectOptions researchPointModes selected=encounter.research.pointMode}}</select></div></div><label class="checkbox"><input type="checkbox" name="showProgressClocks" {{checked encounter.showProgressClocks}}> Show source progress clocks while active or paused</label>{{/if}}
      {{#if isChase}}<div class="nce-chase-editor"><h3>Chase Settings</h3><div class="form-group"><label>Resolution</label><div class="form-fields"><select name="chase.resolution">{{selectOptions chaseResolutions selected=encounter.chase.resolution}}</select></div></div>{{#if isConsequenceChase}}<p class="hint">Each eligible participant makes one check at every obstacle. The chase advances automatically, and the total Chase Successes determine the final consequence.</p><div class="form-group"><label>Chase Objective</label><div class="form-fields"><input name="chase.quarryName" value="{{encounter.chase.quarryName}}"><file-picker type="image" name="chase.quarryImage" value="{{encounter.chase.quarryImage}}"></file-picker></div></div><div class="form-group"><label>Exhaustion</label><div class="form-fields"><select name="chase.exhaustionMode">{{selectOptions exhaustionModes selected=encounter.chase.exhaustionMode}}</select></div></div><section class="nce-consequence-editor"><h4>Final Consequences</h4><p class="hint">The highest qualifying minimum is used when the final phase ends.</p>{{#each encounter.chase.consequenceOutcomes}}<fieldset><legend>{{label}}</legend><div class="nce-config-grid"><label>Minimum Successes<input type="number" min="0" name="chase.consequenceOutcomes.{{@index}}.minimum" value="{{minimum}}"></label><label>Outcome<input name="chase.consequenceOutcomes.{{@index}}.label" value="{{label}}"></label></div><label>Result<textarea name="chase.consequenceOutcomes.{{@index}}.text">{{text}}</textarea></label><button type="button" data-action="removeConsequence" data-index="{{@index}}"><i class="fa-solid fa-trash"></i> Remove Consequence</button></fieldset>{{/each}}<button type="button" data-action="addConsequence"><i class="fa-solid fa-plus"></i> Add Consequence</button></section>{{else}}<div class="form-group"><label>Quarry</label><div class="form-fields"><input name="chase.quarryName" value="{{encounter.chase.quarryName}}"><file-picker type="image" name="chase.quarryImage" value="{{encounter.chase.quarryImage}}"></file-picker></div></div><div class="form-group"><label>Starting Position</label><div class="form-fields"><input type="number" min="0" name="chase.startPosition" value="{{encounter.chase.startPosition}}"><span>obstacles ahead of the party</span></div></div><div class="form-group"><label>Quarry Pace</label><div class="form-fields"><input type="number" min="0" name="chase.pace" value="{{encounter.chase.pace}}"><span>obstacle(s) per turn</span></div></div><div class="form-group"><label>Party Balancing</label><div class="form-fields"><label>Base party <input type="number" min="1" name="chase.basePartySize" value="{{encounter.chase.basePartySize}}"></label><label>Actual party <input type="number" min="0" name="chase.partySize" value="{{encounter.chase.partySize}}"></label><span>Using {{chasePartySize}} characters; each obstacle shifts by 1 CP per character above or below the base.</span></div></div><div class="form-group"><label>Turn Order</label><div class="form-fields"><select name="chase.turnOrder">{{selectOptions chaseTurnOrders selected=encounter.chase.turnOrder}}</select></div></div><div class="form-group"><label>Exhaustion</label><div class="form-fields"><select name="chase.exhaustionMode">{{selectOptions exhaustionModes selected=encounter.chase.exhaustionMode}}</select></div></div><label class="checkbox"><input type="checkbox" name="chase.scriptedQuarry" {{checked encounter.chase.scriptedQuarry}}> Scripted quarry — reaching the quarry does not automatically end the chase</label><label>Capture message<textarea name="chase.victoryText">{{encounter.chase.victoryText}}</textarea></label><label>Escape message<textarea name="chase.escapeText">{{encounter.chase.escapeText}}</textarea></label><label>GM conclusion message<textarea name="chase.conclusionText">{{encounter.chase.conclusionText}}</textarea></label>{{/if}}</div>{{/if}}
      {{#if isChase}}<label class="checkbox"><input type="checkbox" name="chase.openEnded" {{checked encounter.chase.openEnded}}> Open-Ended Chase — the GM selects each acting PC's check, DC, and modifiers after hearing their approach</label>{{#if isOpenEndedChase}}<p class="hint nce-forced-setting"><i class="fa-solid fa-user-shield"></i> Obstacle skills and DCs are hidden. During play, choose an acting PC and use the GM Adjudicated Check control.</p>{{/if}}{{/if}}
      {{#if isSocial}}<label class="checkbox"><input type="checkbox" name="showProgressClocks" {{checked encounter.showProgressClocks}}> Show target progress clocks while active or paused</label>{{/if}}
    </fieldset>
    <fieldset><legend>Participating Characters</legend><div class="nce-participants">{{#each actors}}<div class="nce-participant-editor"><label><input type="checkbox" name="participantIds" value="{{id}}" {{checked selected}}><img src="{{image}}" alt=""> {{name}}</label><input name="participantNicknames.{{id}}" value="{{nickname}}" placeholder="Optional nickname"></div>{{else}}<p>No character Actors are available.</p>{{/each}}</div></fieldset>
    {{#if isQuickParse}}<section class="nce-quick-parse"><h3>Quick Setup from Adventure Text</h3><p>Paste one or more headings such as <em>CROWDED MARKET OBSTACLE 5</em>, followed by Chase Points and Overcome DCs. This replaces the current {{dropLabel}} list.</p><textarea name="quickParse" placeholder="CROWDED MARKET OBSTACLE 5&#10;Chase Points 5; Overcome DC 20 Acrobatics or Athletics to weave through the crowd, DC 18 Society to follow the flow"></textarea><button type="button" data-action="parseTargets"><i class="fa-solid fa-wand-magic-sparkles"></i> Parse {{dropLabel}}</button></section>{{/if}}
    <div class="nce-target-drop-zone" data-target-drop-zone><i class="fa-solid fa-arrow-down-to-bracket"></i><strong>Drop {{dropLabel}} here</strong><span>Drag an Actor or Item from the Foundry sidebar to create a configured entry.</span></div>
    <h2>{{elementHeading}}</h2>
    {{#each encounter.targets}}<fieldset class="nce-target {{#if @root.isOpenEndedChase}}nce-open-ended-target{{/if}}"><legend>{{name}}</legend>
      <input type="hidden" name="targets.{{@index}}.id" value="{{id}}">
      <input type="hidden" name="targets.{{@index}}.sourceUuid" value="{{sourceUuid}}">
      <input type="hidden" name="targets.{{@index}}.sourceType" value="{{sourceType}}">
      <div class="form-group"><label>Name</label><div class="form-fields"><input name="targets.{{@index}}.name" value="{{name}}"></div></div>
      {{#if @root.isSocial}}<div class="form-group"><label>Nickname</label><div class="form-fields"><input name="targets.{{@index}}.nickname" value="{{nickname}}" placeholder="Optional short display name"></div></div>{{/if}}
      <div class="form-group"><label>Image</label><div class="form-fields"><file-picker type="image" name="targets.{{@index}}.image" value="{{image}}"></file-picker></div></div>
      <label>Description<textarea name="targets.{{@index}}.description">{{description}}</textarea></label>
      {{#if @root.isResearch}}<div class="nce-research-source-settings"><label class="checkbox"><input type="checkbox" name="targets.{{@index}}.hidden" {{checked hidden}}> Hidden from players</label><label class="checkbox"><input type="checkbox" name="targets.{{@index}}.exhausted" {{checked exhausted}}> Source exhausted</label><p class="hint">A source is unavailable to a student once their individual maximum is reached. Leave maximum RP at 0 for no limit.</p>{{#each researchRows}}<div class="nce-research-student"><label><input type="checkbox" name="targets.{{@../index}}.availabilityByActor.{{id}}" {{checked available}}> {{name}}</label><label>Maximum RP <input type="number" min="0" name="targets.{{@../index}}.maxPointsByActor.{{id}}" value="{{maximum}}"></label><span>Earned: {{earned}} RP</span></div>{{/each}}</div>{{/if}}
      {{#if @root.isSocial}}<div class="nce-social-lore"><label>Background (GM)<textarea name="targets.{{@index}}.background">{{background}}</textarea></label><label>Appearance (Players)<textarea name="targets.{{@index}}.appearance">{{appearance}}</textarea></label><label>Personality (GM)<textarea name="targets.{{@index}}.personality">{{personality}}</textarea></label><label>GM Notes<textarea name="targets.{{@index}}.gmNotes">{{gmNotes}}</textarea></label><label>Player Notes<textarea name="targets.{{@index}}.playerNotes">{{playerNotes}}</textarea></label></div>{{/if}}
      {{#if @root.isConsequenceChase}}<p class="hint nce-forced-setting"><i class="fa-solid fa-lock"></i> This phase has no CP threshold; checks contribute to the encounter-wide Chase Successes total.</p>{{else}}<div class="form-group"><label>Current Points</label><div class="form-fields"><input type="number" name="targets.{{@index}}.points" value="{{points}}"><label>{{#if @root.isChase}}Base CP{{else}}Goal{{/if}}</label><input type="number" min="0" name="targets.{{@index}}.goal" value="{{goal}}">{{#if @root.isChase}}<span>Party-adjusted: <strong>{{adjustedGoal}} CP</strong></span>{{/if}}</div></div>{{/if}}
      {{#if @root.isChase}}<div class="nce-outcome-points"><label>Failure Exhaustion <input type="number" min="0" name="targets.{{@index}}.failureExhaustion" value="{{failureExhaustion}}"></label><label>Critical Failure Exhaustion <input type="number" min="0" name="targets.{{@index}}.criticalFailureExhaustion" value="{{criticalFailureExhaustion}}"></label></div>{{/if}}
      <h3>Available Checks</h3>
      {{#each checks}}<div class="nce-check"><div class="nce-check-row"><select name="targets.{{@../index}}.checks.{{@index}}.key">{{selectOptions @root.checkChoices selected=key}}</select><input name="targets.{{@../index}}.checks.{{@index}}.label" value="{{label}}" placeholder="Display label"><label>DC <input type="number" min="0" name="targets.{{@../index}}.checks.{{@index}}.dc" value="{{dc}}"></label><input type="hidden" name="targets.{{@../index}}.checks.{{@index}}.id" value="{{id}}"><input type="hidden" name="targets.{{@../index}}.checks.{{@index}}.labelModified" value="{{labelModified}}"><button type="button" data-action="removeCheck" data-target-index="{{@../index}}" data-index="{{@index}}"><i class="fa-solid fa-trash"></i></button></div><label>Player Guidance<textarea name="targets.{{@../index}}.checks.{{@index}}.guidance" placeholder="Explain how this check applies here">{{guidance}}</textarea></label>{{#if @root.isPointEncounter}}<div class="nce-outcome-points"><label>Critical Success <input type="number" name="targets.{{@../index}}.checks.{{@index}}.criticalSuccessPoints" value="{{criticalSuccessPoints}}"></label><label>Success <input type="number" name="targets.{{@../index}}.checks.{{@index}}.successPoints" value="{{successPoints}}"></label><label>Failure <input type="number" name="targets.{{@../index}}.checks.{{@index}}.failurePoints" value="{{failurePoints}}"></label><label>Critical Failure <input type="number" name="targets.{{@../index}}.checks.{{@index}}.criticalFailurePoints" value="{{criticalFailurePoints}}"></label></div>{{/if}}</div>{{/each}}
      <div class="nce-card-actions"><button type="button" data-action="addCheck" data-target-index="{{@index}}"><i class="fa-solid fa-plus"></i> Add Check</button><button type="button" data-action="removeTarget" data-index="{{@index}}"><i class="fa-solid fa-trash"></i> {{@root.removeTargetLabel}}</button></div>
      <section class="nce-social-config"><h3>{{#if @root.isResearch}}Discoveries and Rewards{{else}}Modifiers, Thresholds, and Rewards{{/if}}</h3><p class="hint">Conditional entries are offered to the GM during roll confirmation. Active entries are selected by default.</p>
        {{#each modifiers}}<fieldset class="nce-modifier-editor"><legend>{{label}}</legend><input type="hidden" name="targets.{{@../index}}.modifiers.{{@index}}.id" value="{{id}}"><div class="nce-config-grid"><label>Type<select name="targets.{{@../index}}.modifiers.{{@index}}.kind">{{selectOptions @root.modifierKinds selected=kind}}</select></label><label>Label<input name="targets.{{@../index}}.modifiers.{{@index}}.label" value="{{label}}"></label><label>Effect<select name="targets.{{@../index}}.modifiers.{{@index}}.effect">{{selectOptions @root.modifierEffects selected=effect}}</select></label><label>Value<input type="number" name="targets.{{@../index}}.modifiers.{{@index}}.value" value="{{value}}"></label><label>Check<select name="targets.{{@../index}}.modifiers.{{@index}}.checkKey">{{selectOptions @root.checkChoicesWithAll selected=checkKey}}</select></label><label>Uses (0 = unlimited)<input type="number" min="0" name="targets.{{@../index}}.modifiers.{{@index}}.uses" value="{{uses}}"></label><input type="hidden" name="targets.{{@../index}}.modifiers.{{@index}}.remaining" value="{{remaining}}"></div><label>Description<textarea name="targets.{{@../index}}.modifiers.{{@index}}.description">{{description}}</textarea></label><div class="nce-checkbox-row"><label><input type="checkbox" name="targets.{{@../index}}.modifiers.{{@index}}.conditional" {{checked conditional}}> Conditional</label><label><input type="checkbox" name="targets.{{@../index}}.modifiers.{{@index}}.active" {{checked active}}> Selected by default</label></div><button type="button" data-action="removeModifier" data-target-index="{{@../index}}" data-index="{{@index}}"><i class="fa-solid fa-trash"></i> Remove</button></fieldset>{{/each}}
        <div class="nce-card-actions"><button type="button" data-action="addModifier" data-target-index="{{@index}}" data-kind="weakness"><i class="fa-solid fa-plus"></i> Add Weakness</button><button type="button" data-action="addModifier" data-target-index="{{@index}}" data-kind="resistance"><i class="fa-solid fa-plus"></i> Add Resistance</button><button type="button" data-action="addModifier" data-target-index="{{@index}}" data-kind="circumstance"><i class="fa-solid fa-plus"></i> Add Circumstance</button></div>
        <h3>Thresholds and Rewards</h3>{{#each thresholds}}<fieldset class="nce-threshold-editor"><legend>{{label}} — {{points}} points</legend><input type="hidden" name="targets.{{@../index}}.thresholds.{{@index}}.id" value="{{id}}"><div class="form-group"><label>Threshold</label><div class="form-fields"><input type="number" name="targets.{{@../index}}.thresholds.{{@index}}.points" value="{{points}}"><input name="targets.{{@../index}}.thresholds.{{@index}}.label" value="{{label}}"></div></div><label>Description<textarea name="targets.{{@../index}}.thresholds.{{@index}}.text">{{text}}</textarea></label>
          {{#each rewards}}<div class="nce-reward-editor"><input type="hidden" name="targets.{{@../../index}}.thresholds.{{@../index}}.rewards.{{@index}}.id" value="{{id}}"><div class="nce-config-grid"><label>Kind<select name="targets.{{@../../index}}.thresholds.{{@../index}}.rewards.{{@index}}.kind">{{selectOptions @root.rewardKinds selected=kind}}</select></label><label>Label<input name="targets.{{@../../index}}.thresholds.{{@../index}}.rewards.{{@index}}.label" value="{{label}}"></label><label>Activation<select name="targets.{{@../../index}}.thresholds.{{@../index}}.rewards.{{@index}}.activation">{{selectOptions @root.rewardActivations selected=activation}}</select></label><label>Target<select name="targets.{{@../../index}}.thresholds.{{@../index}}.rewards.{{@index}}.targetId">{{selectOptions @root.targetChoices selected=targetId}}</select></label><label>Effect<select name="targets.{{@../../index}}.thresholds.{{@../index}}.rewards.{{@index}}.effect">{{selectOptions @root.modifierEffects selected=effect}}</select></label><label>Value / Amount<input type="number" name="targets.{{@../../index}}.thresholds.{{@../index}}.rewards.{{@index}}.value" value="{{value}}"></label><label>Currency<select name="targets.{{@../../index}}.thresholds.{{@../index}}.rewards.{{@index}}.currency">{{selectOptions @root.currencies selected=currency}}</select></label><label>Check<select name="targets.{{@../../index}}.thresholds.{{@../index}}.rewards.{{@index}}.checkKey">{{selectOptions @root.checkChoicesWithAll selected=checkKey}}</select></label><label>Uses (0 = unlimited)<input type="number" min="0" name="targets.{{@../../index}}.thresholds.{{@../index}}.rewards.{{@index}}.uses" value="{{uses}}"></label><input type="hidden" name="targets.{{@../../index}}.thresholds.{{@../index}}.rewards.{{@index}}.remaining" value="{{remaining}}"><input type="hidden" name="targets.{{@../../index}}.thresholds.{{@../index}}.rewards.{{@index}}.active" value="{{active}}"><input type="hidden" name="targets.{{@../../index}}.thresholds.{{@../index}}.rewards.{{@index}}.applied" value="{{applied}}"></div><div class="nce-reward-item"><input type="hidden" name="targets.{{@../../index}}.thresholds.{{@../index}}.rewards.{{@index}}.itemUuid" value="{{itemUuid}}"><input type="hidden" name="targets.{{@../../index}}.thresholds.{{@../index}}.rewards.{{@index}}.itemImage" value="{{itemImage}}"><label>Linked Item<input name="targets.{{@../../index}}.thresholds.{{@../index}}.rewards.{{@index}}.itemName" value="{{itemName}}" placeholder="Drop an Item below"></label><div class="nce-reward-drop-zone" data-reward-drop-zone data-target-index="{{@../../index}}" data-threshold-index="{{@../index}}" data-reward-index="{{@index}}"><i class="fa-solid fa-box-open"></i> Drop an Item reward here</div></div><label>Description<textarea name="targets.{{@../../index}}.thresholds.{{@../index}}.rewards.{{@index}}.description">{{description}}</textarea></label><div class="nce-checkbox-row"><label><input type="checkbox" name="targets.{{@../../index}}.thresholds.{{@../index}}.rewards.{{@index}}.playerVisible" {{checked playerVisible}}> Show to players</label><label><input type="checkbox" name="targets.{{@../../index}}.thresholds.{{@../index}}.rewards.{{@index}}.conditional" {{checked conditional}}> Conditional</label></div><button type="button" data-action="removeReward" data-target-index="{{@../../index}}" data-threshold-index="{{@../index}}" data-index="{{@index}}"><i class="fa-solid fa-trash"></i> Remove Reward</button></div>{{/each}}
          <div class="nce-card-actions"><button type="button" data-action="addReward" data-target-index="{{@../index}}" data-threshold-index="{{@index}}"><i class="fa-solid fa-plus"></i> Add Reward</button><button type="button" data-action="removeThreshold" data-target-index="{{@../index}}" data-index="{{@index}}"><i class="fa-solid fa-trash"></i> Remove Threshold</button></div></fieldset>{{/each}}<button type="button" data-action="addThreshold" data-target-index="{{@index}}"><i class="fa-solid fa-plus"></i> Add Threshold</button>
      </section>
    </fieldset>{{/each}}
    <button type="button" data-action="addTarget"><i class="fa-solid fa-plus"></i> {{addTargetLabel}}</button>
  </section>
  <footer class="form-footer"><button type="submit"><i class="fa-solid fa-floppy-disk"></i> Save Changes</button></footer>
</div>

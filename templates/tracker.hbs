<section class="nce-tracker">
{{#if noEncounter}}
  <div class="nce-empty"><i class="fa-solid fa-people-group"></i><p>No active non-combat encounter.</p>{{#if isGM}}<button type="button" data-action="manage">Manage Encounters</button>{{/if}}</div>
{{else}}
  <header><img src="{{encounter.image}}" alt=""><div><h2>{{encounter.name}}</h2><p>{{typeLabel}} — {{encounter.status}} — Round {{encounter.currentRound}}{{#if encounter.roundLimit}} of {{encounter.roundLimit}}{{/if}}</p></div></header>
  {{#if encounter.description}}<section><h3>Situation and Stakes</h3><p>{{encounter.description}}</p></section>{{/if}}
  <section><h3>{{#if isResearch}}Researchers{{else}}Participants{{/if}}</h3>
    <ul class="nce-roster">{{#each participants}}<li class="{{#if acted}}acted{{/if}}"><img src="{{image}}" alt=""><span>{{displayName}}{{#if @root.isResearch}} <small>{{researchTotal}} RP</small>{{/if}}</span><i class="fa-solid {{#if acted}}fa-check{{else}}fa-hourglass{{/if}}"></i></li>{{else}}<li>No participants selected.</li>{{/each}}</ul>
    <div class="nce-choice-grid">{{#each participants}}{{#if owned}}<button type="button" data-action="selectActor" data-id="{{id}}" class="{{#if selected}}selected{{/if}} {{#if acted}}acted{{/if}}" {{#if acted}}disabled{{/if}}><img src="{{image}}" alt="">{{displayName}}</button>{{/if}}{{/each}}</div>
  </section>
  <section><h3>{{#if isResearch}}Research Sources{{else}}Encounter Elements{{/if}}</h3><div class="nce-choice-grid nce-target-choices">{{#each encounter.targets}}<button type="button" data-action="selectTarget" data-id="{{id}}" class="{{#if selected}}selected{{/if}}"><img src="{{image}}" alt=""><span>{{displayName}}{{#if exhausted}} <small>(Exhausted)</small>{{/if}}</span></button>{{else}}<p>No sources are currently available.</p>{{/each}}</div></section>
  {{#if selectedTarget}}{{#if selectedActor}}<section class="nce-head-to-head"><figure><img src="{{selectedActor.image}}" alt=""><figcaption>{{selectedActor.displayName}}</figcaption></figure><strong>VS</strong><figure><img src="{{selectedTarget.image}}" alt=""><figcaption>{{selectedTarget.displayName}}</figcaption></figure></section>{{/if}}<article class="nce-active-target"><header><img src="{{selectedTarget.image}}" alt=""><div><h3>{{selectedTarget.displayName}}</h3>{{#if selectedTarget.description}}<p>{{selectedTarget.description}}</p>{{/if}}{{#if selectedTarget.appearance}}<p><strong>Appearance:</strong> {{selectedTarget.appearance}}</p>{{/if}}{{#if selectedTarget.playerNotes}}<p>{{selectedTarget.playerNotes}}</p>{{/if}}{{#if isGM}}{{#if selectedTarget.background}}<p><strong>Background:</strong> {{selectedTarget.background}}</p>{{/if}}{{#if selectedTarget.personality}}<p><strong>Personality:</strong> {{selectedTarget.personality}}</p>{{/if}}{{#if selectedTarget.gmNotes}}<p><strong>GM Notes:</strong> {{selectedTarget.gmNotes}}</p>{{/if}}{{/if}}</div></header>
    {{#if isResearch}}<p class="nce-research-interval"><i class="fa-solid fa-hourglass-half"></i> Each research check represents {{encounter.research.intervalHours}} hour{{#unless (eq encounter.research.intervalHours 1)}}s{{/unless}} of study.</p>{{#unless selectedTarget.sourceAvailable}}<p class="nce-source-unavailable"><i class="fa-solid fa-lock"></i> This source is unavailable to the selected researcher.</p>{{/unless}}{{/if}}
    {{#if encounter.showProgressClocks}}<div class="nce-progress-clock" style="--progress: {{selectedTarget.progressPct}}"><span>{{selectedTarget.points}}{{#if selectedTarget.goal}}/{{selectedTarget.goal}}{{/if}}</span></div>{{else}}<div class="nce-progress"><span style="width: {{selectedTarget.progressPct}}%"></span></div><p class="nce-points"><strong>{{selectedTarget.points}}{{#if selectedTarget.goal}} / {{selectedTarget.goal}}{{/if}}</strong> {{#if isResearch}}RP{{else}}points{{/if}}</p>{{/if}}
    {{#if isResearch}}{{#if selectedActor}}<p class="nce-research-personal">{{selectedActor.displayName}} has earned <strong>{{selectedTarget.selectedActorPoints}}{{#if selectedTarget.selectedActorMaximum}} / {{selectedTarget.selectedActorMaximum}}{{/if}} RP</strong> from this source.</p>{{/if}}{{#if isGM}}<div class="nce-research-contributions"><h4>Researcher Progress</h4>{{#each selectedTarget.researchRows}}<div><span>{{displayName}}: {{sourcePoints}}{{#if sourceMaximum}} / {{sourceMaximum}}{{/if}} RP{{#unless available}} <em>(unavailable)</em>{{/unless}}</span><button type="button" data-action="adjustResearchPoints" data-id="{{../id}}" data-actor-id="{{id}}" data-delta="-1">−</button><button type="button" data-action="adjustResearchPoints" data-id="{{../id}}" data-actor-id="{{id}}" data-delta="1">+</button></div>{{/each}}</div>{{/if}}{{/if}}
    {{#if isGM}}<div class="nce-inline-actions"><button type="button" data-action="adjustPoints" data-id="{{selectedTarget.id}}" data-delta="-1"><i class="fa-solid fa-minus"></i> 1</button><button type="button" data-action="adjustPoints" data-id="{{selectedTarget.id}}" data-delta="1"><i class="fa-solid fa-plus"></i> 1</button></div>{{/if}}
    {{#if selectedTarget.checks.length}}<h4>Available Checks</h4><div class="nce-runtime-checks">{{#each selectedTarget.checks}}<div class="nce-runtime-check"><div><strong>{{label}}{{#if actorModifier}} ({{actorModifier}}){{/if}}{{#if @root.showDC}} — DC {{dc}}{{/if}}</strong>{{#if guidance}}<p>{{guidance}}</p>{{/if}}</div>{{#if @root.canRequest}}<button type="button" data-action="requestCheck" data-check-id="{{id}}"><i class="fa-solid fa-dice-d20"></i> Request Check</button>{{/if}}</div>{{/each}}</div>{{/if}}
    {{#if selectedTarget.unlockedThresholds.length}}<section class="nce-unlocked-rewards"><h4>{{#if isResearch}}Discoveries{{else}}Accomplishments and Rewards{{/if}}</h4>{{#each selectedTarget.unlockedThresholds}}<article><h5>{{label}}</h5>{{#if text}}<p>{{text}}</p>{{/if}}{{#if rewards.length}}<ul>{{#each rewards}}<li><strong>{{label}}</strong>{{#if description}} — {{description}}{{/if}}{{#if @root.isGM}}{{#unless (eq kind "points")}} <button type="button" data-action="toggleReward" data-id="{{id}}">{{#if active}}Hide{{else}}Reveal{{/if}}</button>{{/unless}}{{#if (eq kind "points")}}{{#unless applied}}<button type="button" data-action="applyReward" data-id="{{id}}">Apply</button>{{/unless}}{{/if}}{{/if}}</li>{{/each}}</ul>{{/if}}</article>{{/each}}</section>{{/if}}
  </article>{{/if}}
  {{#if isGM}}{{#if pendingRequests.length}}<section class="nce-requests"><h3>Pending Check Requests</h3>{{#each pendingRequests}}<article><div><strong>{{actorName}} → {{targetName}}</strong><p>{{checkLabel}} ({{modifier}})</p></div><button type="button" data-action="completeRequest" data-id="{{id}}"><i class="fa-solid fa-dice-d20"></i> Review & Roll</button><button type="button" data-action="cancelRequest" data-id="{{id}}"><i class="fa-solid fa-xmark"></i> Cancel</button></article>{{/each}}</section>{{/if}}{{/if}}
  {{#if isGM}}{{#if encounter.log.length}}<details class="nce-log"><summary>Encounter Log ({{encounter.log.length}})</summary><ol>{{#each encounter.log}}<li><strong>Round {{round}}:</strong> {{text}}</li>{{/each}}</ol></details>{{/if}}{{/if}}
  {{#if isGM}}<footer class="nce-runtime-footer"><button type="button" data-action="manage"><i class="fa-solid fa-pen-to-square"></i> Edit</button><button type="button" data-action="undo" {{#unless hasUndo}}disabled{{/unless}}><i class="fa-solid fa-rotate-left"></i> Undo</button><button type="button" data-action="nextRound"><i class="fa-solid fa-forward-step"></i> Next Round</button><button type="button" data-action="pause"><i class="fa-solid fa-pause"></i> Pause</button><button type="button" class="danger" data-action="end"><i class="fa-solid fa-book"></i> End & Publish</button></footer>{{/if}}
{{/if}}
</section>

<section class="nce-tracker">
{{#if noEncounter}}
  <div class="nce-empty"><i class="fa-solid fa-people-group"></i><p>No active non-combat encounter.</p>{{#if isGM}}<button type="button" data-action="manage">Manage Encounters</button>{{/if}}</div>
{{else}}
  <header><div><h2>{{encounter.name}}</h2><p>{{typeLabel}} — {{encounter.status}} — Round {{encounter.currentRound}}{{#if encounter.roundLimit}} of {{encounter.roundLimit}}{{/if}}</p></div></header>
  {{#if encounter.description}}<section><h3>Situation and Stakes</h3><p>{{encounter.description}}</p></section>{{/if}}
  <section><h3>{{#if isResearch}}Researchers{{else}}Participants{{/if}}</h3>
    <ul class="nce-roster">{{#each participants}}<li class="{{#if acted}}acted{{/if}} {{#if droppedOut}}acted{{/if}}"><img src="{{image}}" alt=""><span>{{displayName}}{{#if @root.isResearch}} <small>{{researchTotal}} RP</small>{{/if}}{{#if @root.isChase}} <small>Exhaustion {{exhaustion}}/5{{#if droppedOut}} — out{{/if}}</small>{{/if}}</span><i class="fa-solid {{#if acted}}fa-check{{else}}fa-hourglass{{/if}}"></i></li>{{else}}<li>No participants selected.</li>{{/each}}</ul>
    <p class="nce-check-count"><strong>{{phaseChecksCompleted}}/{{eligibleParticipantCount}}</strong> checks completed this phase · <strong>{{completedChecks}}</strong> completed overall</p>
    <div class="nce-choice-grid">{{#each participants}}{{#if owned}}<button type="button" data-action="selectActor" data-id="{{id}}" class="{{#if selected}}selected{{/if}} {{#if acted}}acted{{/if}}" {{#if acted}}disabled{{/if}} {{#if droppedOut}}disabled{{/if}}><img src="{{image}}" alt="">{{displayName}}</button>{{/if}}{{/each}}</div>
  </section>
  {{#if isChase}}<section class="nce-chase-status"><h3>{{#if isConsequenceChase}}Chase Objective: {{/if}}{{encounter.chase.quarryName}}</h3>{{#if encounter.chase.concluded}}<p class="nce-chase-concluded">{{#if (eq encounter.chase.outcome "victory")}}{{encounter.chase.victoryText}}{{else}}{{#if (eq encounter.chase.outcome "escape")}}{{encounter.chase.escapeText}}{{else}}{{#if consequenceOutcome}}<strong>{{consequenceOutcome.label}}:</strong> {{consequenceOutcome.text}}{{else}}{{encounter.chase.conclusionText}}{{/if}}{{/if}}{{/if}}</p>{{else}}{{#if isConsequenceChase}}<p><strong>{{encounter.chase.successes}}</strong> Chase Points — phase {{encounter.currentRound}} of {{chasePhaseCount}}. Each eligible participant makes one check this phase.</p>{{else}}<p>The quarry is {{#if encounter.chase.scriptedQuarry}}moving through a scripted chase.{{else}}at obstacle {{chaseQuarryPosition}}.{{/if}}{{#if @root.isPostCombatChase}} Chase Exhaustion clears completely after a short rest.{{else}} The quarry’s position is marked on the obstacle track.{{/if}}</p>{{/if}}{{/if}}<ol class="nce-obstacle-track">{{#each encounter.targets}}<li class="{{#if obstacleCompleted}}completed{{/if}} {{#if obstacleCurrent}}current{{/if}} {{#if obstacleQuarry}}quarry{{/if}}"><span>{{obstacleIndex}}. {{displayName}}</span>{{#if @root.isConsequenceChase}}<small>{{#if obstacleCompleted}}Complete{{else}}{{#if obstacleCurrent}}Current phase{{else}}Upcoming{{/if}}{{/if}}</small>{{else}}<small>{{points}}/{{effectiveGoal}} CP</small>{{/if}}</li>{{/each}}</ol></section>{{else}}<section><h3>{{#if isResearch}}Research Sources{{else}}Encounter Elements{{/if}}</h3><div class="nce-choice-grid nce-target-choices">{{#each encounter.targets}}<button type="button" data-action="selectTarget" data-id="{{id}}" class="{{#if selected}}selected{{/if}}"><img src="{{image}}" alt=""><span>{{displayName}}{{#if exhausted}} <small>(Exhausted)</small>{{/if}}</span></button>{{else}}<p>No sources are currently available.</p>{{/each}}</div></section>{{/if}}
  {{#if selectedTarget}}{{#if selectedActor}}<section class="nce-head-to-head {{#if isChase}}nce-chase-head-to-head{{/if}}"><figure><img src="{{selectedActor.image}}" alt=""><figcaption>{{selectedActor.displayName}}</figcaption></figure><strong>{{#if isChase}}OVERCOMES{{else}}VS{{/if}}</strong><figure><img src="{{selectedTarget.image}}" alt=""><figcaption>{{selectedTarget.displayName}}</figcaption></figure>{{#if isChase}}<strong>TO REACH</strong><figure><img src="{{encounter.chase.quarryImage}}" alt=""><figcaption>{{encounter.chase.quarryName}}</figcaption></figure>{{/if}}</section>{{/if}}<article class="nce-active-target"><header><img src="{{selectedTarget.image}}" alt=""><div><h3>{{#if isChase}}Obstacle {{selectedTarget.obstacleIndex}}: {{/if}}{{selectedTarget.displayName}}</h3>{{#if selectedTarget.description}}<p>{{selectedTarget.description}}</p>{{/if}}{{#if selectedTarget.appearance}}<p><strong>Appearance:</strong> {{selectedTarget.appearance}}</p>{{/if}}{{#if selectedTarget.playerNotes}}<p>{{selectedTarget.playerNotes}}</p>{{/if}}{{#if isGM}}{{#if selectedTarget.background}}<p><strong>Background:</strong> {{selectedTarget.background}}</p>{{/if}}{{#if selectedTarget.personality}}<p><strong>Personality:</strong> {{selectedTarget.personality}}</p>{{/if}}{{#if selectedTarget.gmNotes}}<p><strong>GM Notes:</strong> {{selectedTarget.gmNotes}}</p>{{/if}}{{/if}}</div></header>
    {{#if isResearch}}<p class="nce-research-interval"><i class="fa-solid fa-hourglass-half"></i> Each research check represents {{encounter.research.intervalHours}} hour{{#unless (eq encounter.research.intervalHours 1)}}s{{/unless}} of study.</p>{{#unless selectedTarget.sourceAvailable}}<p class="nce-source-unavailable"><i class="fa-solid fa-lock"></i> This source is unavailable to the selected researcher.</p>{{/unless}}{{/if}}
    {{#if isConsequenceChase}}<p class="nce-points"><strong>{{encounter.chase.successes}}</strong> Chase Points</p>{{else}}{{#if encounter.showProgressClocks}}<div class="nce-progress-clock" style="--progress: {{selectedTarget.progressPct}}"><span>{{selectedTarget.points}}{{#if selectedTarget.effectiveGoal}}/{{selectedTarget.effectiveGoal}}{{/if}}</span></div>{{else}}<div class="nce-progress"><span style="width: {{selectedTarget.progressPct}}%"></span></div><p class="nce-points"><strong>{{selectedTarget.points}}{{#if selectedTarget.effectiveGoal}} / {{selectedTarget.effectiveGoal}}{{/if}}</strong> {{#if isResearch}}RP{{else}}{{#if isChase}}Chase Points{{else}}points{{/if}}{{/if}}</p>{{/if}}{{/if}}
    {{#if isResearch}}{{#if selectedActor}}<p class="nce-research-personal">{{selectedActor.displayName}} has earned <strong>{{selectedTarget.selectedActorPoints}}{{#if selectedTarget.selectedActorMaximum}} / {{selectedTarget.selectedActorMaximum}}{{/if}} RP</strong> from this source.</p>{{/if}}{{#if isGM}}<div class="nce-research-contributions"><h4>Researcher Progress</h4>{{#each selectedTarget.researchRows}}<div><span>{{displayName}}: {{sourcePoints}}{{#if sourceMaximum}} / {{sourceMaximum}}{{/if}} RP{{#unless available}} <em>(unavailable)</em>{{/unless}}</span><button type="button" data-action="adjustResearchPoints" data-id="{{../id}}" data-actor-id="{{id}}" data-delta="-1">−</button><button type="button" data-action="adjustResearchPoints" data-id="{{../id}}" data-actor-id="{{id}}" data-delta="1">+</button></div>{{/each}}</div>{{/if}}{{/if}}
    {{#if isGM}}{{#unless isConsequenceChase}}<div class="nce-inline-actions"><button type="button" data-action="adjustPoints" data-id="{{selectedTarget.id}}" data-delta="-1"><i class="fa-solid fa-minus"></i> 1</button><button type="button" data-action="adjustPoints" data-id="{{selectedTarget.id}}" data-delta="1"><i class="fa-solid fa-plus"></i> 1</button></div>{{/unless}}{{/if}}
    {{#if selectedTarget.checks.length}}<h4>Available Checks</h4><div class="nce-runtime-checks">{{#each selectedTarget.checks}}<div class="nce-runtime-check"><div><strong>{{label}}{{#if actorModifier}} ({{actorModifier}}){{/if}}{{#if @root.showDC}} — DC {{dc}}{{/if}}</strong>{{#if guidance}}<p>{{guidance}}</p>{{/if}}</div>{{#if @root.canRequest}}<button type="button" data-action="requestCheck" data-check-id="{{id}}"><i class="fa-solid fa-dice-d20"></i> Make a Check</button>{{/if}}</div>{{/each}}</div>{{/if}}
    {{#if selectedTarget.unlockedThresholds.length}}<section class="nce-unlocked-rewards"><h4>{{#if isResearch}}Discoveries{{else}}Accomplishments and Rewards{{/if}}</h4>{{#each selectedTarget.unlockedThresholds}}<article><h5>{{label}}</h5>{{#if text}}<p>{{text}}</p>{{/if}}{{#if rewards.length}}<ul>{{#each rewards}}<li><strong>{{label}}</strong>{{#if description}} — {{description}}{{/if}}{{#if @root.isGM}}{{#unless (eq kind "points")}} <button type="button" data-action="toggleReward" data-id="{{id}}">{{#if active}}Hide{{else}}Reveal{{/if}}</button>{{/unless}}{{#if (eq kind "points")}}{{#unless applied}}<button type="button" data-action="applyReward" data-id="{{id}}">Apply</button>{{/unless}}{{/if}}{{/if}}</li>{{/each}}</ul>{{/if}}</article>{{/each}}</section>{{/if}}
  </article>{{/if}}
  {{#if isGM}}{{#if pendingRequests.length}}<section class="nce-requests"><h3>Pending Check Requests</h3>{{#each pendingRequests}}<article><div><strong>{{actorName}} → {{targetName}}</strong><p>{{checkLabel}} ({{modifier}})</p></div><button type="button" data-action="completeRequest" data-id="{{id}}"><i class="fa-solid fa-dice-d20"></i> Review & Roll</button><button type="button" data-action="cancelRequest" data-id="{{id}}"><i class="fa-solid fa-xmark"></i> Cancel</button></article>{{/each}}</section>{{/if}}{{/if}}
  <details class="nce-log" open><summary>Encounter Log ({{encounter.log.length}})</summary>{{#if encounter.log.length}}<ol>{{#each encounter.log}}<li><strong>Round {{round}}:</strong> {{text}}</li>{{/each}}</ol>{{else}}<p class="hint empty-log">No checks have been completed yet.</p>{{/if}}</details>
  {{#if isGM}}<footer class="nce-runtime-footer"><button type="button" data-action="manage"><i class="fa-solid fa-pen-to-square"></i> Edit</button><button type="button" data-action="undo" {{#unless hasUndo}}disabled{{/unless}}><i class="fa-solid fa-rotate-left"></i> Undo</button><button type="button" data-action="nextRound"><i class="fa-solid fa-forward-step"></i> Next Round</button>{{#if isChase}}{{#unless encounter.chase.concluded}}{{#if isConsequenceChase}}<button type="button" data-action="concludeChase" data-outcome="consequence"><i class="fa-solid fa-flag-checkered"></i> Resolve Consequences</button>{{else}}<button type="button" data-action="concludeChase" data-outcome="victory"><i class="fa-solid fa-trophy"></i> Party Wins</button><button type="button" data-action="concludeChase" data-outcome="escape"><i class="fa-solid fa-person-running"></i> Quarry Escapes</button><button type="button" data-action="concludeChase" data-outcome="custom"><i class="fa-solid fa-flag-checkered"></i> Conclude Chase</button>{{/if}}{{/unless}}{{/if}}<button type="button" data-action="pause"><i class="fa-solid fa-pause"></i> Pause</button><button type="button" class="danger" data-action="end"><i class="fa-solid fa-book"></i> End & Publish</button></footer>{{/if}}
{{/if}}
</section>

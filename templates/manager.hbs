<section class="nce-manager">
  <header class="nce-toolbar"><button type="button" data-action="create"><i class="fa-solid fa-plus"></i> Create Encounter</button>{{#if activeEncounter}}<button type="button" data-action="open"><i class="fa-solid fa-up-right-from-square"></i> Open Active Encounter</button>{{/if}}</header>
  <p class="hint">Select an encounter to edit it. Right-click an encounter for its lifecycle, import/export, and delete options.</p>
  <div class="nce-list">{{#each encounters}}<article class="nce-row nce-manager-entry {{#if active}}active{{/if}}" data-id="{{id}}" tabindex="0"><img src="{{image}}" alt=""><div><h3>{{name}}</h3><p>{{typeLabel}} · {{status}} · {{targets.length}} target(s)</p></div></article>{{else}}<div class="nce-empty"><i class="fa-solid fa-people-group"></i><p>No encounters yet.</p></div>{{/each}}</div>
</section>

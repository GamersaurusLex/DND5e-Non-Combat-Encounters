<section class="nce-manager">
  <header class="nce-toolbar"><button type="button" data-action="create"><i class="fa-solid fa-plus"></i> Create Encounter</button>{{#if encounters.length}}<button type="button" data-action="open"><i class="fa-solid fa-up-right-from-square"></i> Open Active Encounter</button>{{/if}}</header>
  <div class="nce-list">{{#each encounters}}<article class="nce-row {{#if active}}active{{/if}}"><img src="{{image}}" alt=""><div><h3>{{name}}</h3><p>{{typeLabel}} · {{status}} · {{targets.length}} target(s)</p></div><div class="nce-actions">{{#if (eq status "paused")}}<button type="button" data-action="resume" data-id="{{id}}">Resume</button>{{else}}{{#if (eq status "active")}}<button type="button" data-action="pause" data-id="{{id}}">Pause</button>{{else}}<button type="button" data-action="activate" data-id="{{id}}">Activate</button>{{/if}}{{/if}}<button type="button" data-action="edit" data-id="{{id}}">Edit</button><button type="button" data-action="remove" data-id="{{id}}" aria-label="Delete"><i class="fa-solid fa-trash"></i></button></div></article>{{else}}<div class="nce-empty"><i class="fa-solid fa-people-group"></i><p>No encounters yet.</p></div>{{/each}}</div>
</section>
